{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dawsend",
  "mainBinaryName": "dawsend",
  "identifier": "com.metaloul.dawsend",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Dawsend",
        "width": 440,
        "height": 640,
        "minWidth": 380,
        "minHeight": 480,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1MzlCRjkwQ0U0NEYyMUMKUldRYzhrVE9rTDg1dGUrVktOSHJTdmlTVlBMWEtWcUh0d2tXSVZEbzgyYmZTREZCUER5MGJIWXgK",
      "endpoints": [
        "https://github.com/Metaloul/Dawsend/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
